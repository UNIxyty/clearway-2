# EAD Basic – AIP download (/aip-test and scripts/ead-download-aip-pdf.mjs)
EAD_USER=your_ead_username
EAD_PASSWORD_ENC=base64_encoded_password

# Optional: AI extraction and GEN rewriting (scripts/ead-extract-aip-from-pdf-ai.mjs, aip-sync-server.mjs, /aip-test)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# See docs/OPENAI-MODELS-GEN.md for Gen 5 and other model IDs (e.g. gpt-5.4, gpt-5-mini, gpt-4.1).

# OpenRouter API key – required when using Anthropic or Google models (model ID contains "/")
# Used by aip-sync-server.mjs for both AIP extract and GEN rewrite when model is e.g. anthropic/claude-sonnet-4 or google/gemini-2.5-flash
# Get a key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_GEN_MODEL=anthropic/claude-opus-4

# Supabase auth (portal login)
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# NEXT_PUBLIC_SITE_URL=https://your-portal-domain.example
# LEON_REFRESH_TOKEN_ENCRYPTION_KEY=long_random_secret_for_digital_wall_tokens

# Self-hosted storage roots
STORAGE_ROOT=/storage
CACHE_ROOT=/cache
NODE_ENV=production

# Internal sync service URLs (for Docker/Coolify network)
# NOTAM_SYNC_URL=http://notam-sync:3001
# WEATHER_SYNC_URL=http://weather-sync:3001
# AIP_SYNC_URL=http://aip-sync:3002
# NOTAM_SCRAPER=skylink

# Lithuania HITL noVNC test flow (optional overrides)
# LITHUANIA_SELENIUM_URL=http://lithuania-browser:4444/wd/hub
# LITHUANIA_NOVNC_URL=http://your-hostname:6080/?autoconnect=1&resize=scale

# SkyLink API (NOTAM + weather sync source)
# SKYLINK_API_KEY=your_rapidapi_key
# SKYLINK_API_HOST=skylink-api.p.rapidapi.com
# SKYLINK_API_BASE_URL=https://skylink-api.p.rapidapi.com

# Telegram debug bot (optional)
# Create a bot via @BotFather and set webhook to /api/telegram/debug
# TELEGRAM_BOT_TOKEN=123456789:AA...
# TELEGRAM_BOT_WEBHOOK_SECRET=long_random_secret
# TELEGRAM_DEBUG_ALLOWED_CHAT_IDS=123456789,-1001234567890
# Telegram bug reports (optional; defaults to TELEGRAM_BOT_TOKEN if TELEGRAM_BUG_BOT_TOKEN is not set)
# TELEGRAM_BUG_BOT_TOKEN=123456789:AA...
# TELEGRAM_BUG_BOT_WEBHOOK_SECRET=another_long_random_secret
# TELEGRAM_BUG_CHAT_ID=-1001234567890
# TELEGRAM_BUG_ALLOWED_CHAT_IDS=123456789,-1001234567890

# Pickem football data provider (API-Sports format)
# FOOTBALL_API_BASE_URL=https://v3.football.api-sports.io
# FOOTBALL_API_KEY=your_api_sports_key
# FOOTBALL_API_LEAGUE_ID=1
# FOOTBALL_API_SEASON=2026

# Pickem submission email (optional, via Resend)
# RESEND_API_KEY=re_xxxxxxxxx
# PICKEM_EMAIL_FROM="Clearway Pickem <no-reply@your-domain.com>"

# Transactional email system (Resend + Handlebars templates)
# RESEND_API_KEY=re_xxxxxxxxx
# EMAIL_FROM_ADDRESS=noreply@verxyl.com
# APP_BASE_URL=https://your-pickem-domain.com
# UNSUBSCRIBE_SECRET=long_random_secret_at_least_32_chars

# --- Amazon Bedrock (dispatcher agent; see docs/aws-bedrock-setup.md) ---
# Credentials: the clearway-agent IAM user key (invoke-only policy). Never commit values.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# BEDROCK_REGION=eu-north-1
# BEDROCK_MODEL_ID=            # Claude EU inference profile id, from: node scripts/bedrock-smoke-test.mjs --list
# BEDROCK_FAST_MODEL_ID=       # optional cheaper profile for sub-tasks
# BEDROCK_EMBED_MODEL_ID=cohere.embed-multilingual-v3
# BEDROCK_RERANK_MODEL_ID=cohere.rerank-v3-5:0

# --- Agent email ---
# The agent sends under its own identity, separate from the Digital Wall's
# alerting address, so agent mail can be filtered and traced on its own.
# The domain MUST be verified in Resend (verxyl.com today) or sends are rejected.
# AGENT_EMAIL_FROM=Clearway AI Agent <agent@verxyl.com>
# Domains treated as internal (no confirmation needed). Defaults to the
# requester's own email domain.
# AGENT_EMAIL_INTERNAL_DOMAINS=verxyl.com,clearway.aero
