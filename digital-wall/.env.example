LEON_OPR_ID=your_operator_id
LEON_REFRESH_TOKEN=your_refresh_token

# Supabase (recommended for operator + aircraft visibility storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional OAuth mode (instead of API-key refresh token flow)
# LEON_CLIENT_ID=your_client_id
# LEON_CLIENT_SECRET=your_client_secret

# Optional tuning
LEON_SANDBOX=true
LEON_SYNC_POLL_MS=600000
LEON_SYNC_RANGE_START=2026-01-01
LEON_SYNC_RANGE_END=2026-12-31

# ── Authentication (Digital Wall console + display) ─────────────────────────
# The anon key of the SAME Supabase project the main portal uses; sessions are
# verified server-side against /auth/v1/user. If neither the anon key nor the
# service-role key is set, auth degrades to a mock local user (dev only).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Escape hatch for local testing only. Never enable in production.
# DISABLE_AUTH_FOR_TESTING=true

# ── Main portal (NOTAM / weather / AIP source for flight info + alerts) ─────
# Base URL of the main Clearway Next.js portal. In the production compose
# network this is the portal container; locally use http://localhost:3000.
PORTAL_BASE_URL=http://clearway-selfhosted:3000
# Shared secret that bypasses portal user-auth for server-to-server calls
# (sent as the x-debug-runner-secret header; same value as the portal's
# DEBUG_RUNNER_INTERNAL_SECRET).
PORTAL_INTERNAL_SECRET=your_internal_secret
# Cache TTL for per-airport NOTAM/weather lookups made by the wall backend.
# FLIGHT_INFO_CACHE_TTL_MS=600000

# ── Email ────────────────────────────────────────────────────────────────────
# Reuses the Resend API already configured for the main portal. The FROM
# domain must be verified in Resend or every send fails with a 403 (the
# failure is logged and shown on the console NOTAM Check page).
RESEND_API_KEY=your_resend_api_key
DIGITAL_WALL_EMAIL_FROM="Clearway Digital Wall <no-reply@your-domain.com>"
# Point sends at a local capture server in tests; leave unset in production.
# RESEND_BASE_URL=https://api.resend.com

# ── Daily NOTAM check (wall sign + notification email) ───────────────────────
# REQUIRED recipient(s) of the daily "NOTAMs need to be checked" notification
# (comma-separated). There is NO default — unset means no email is sent and
# an error is surfaced on the console NOTAM Check page.
NOTAM_DIGEST_TO=you@your-domain.com
# While airports remain unchecked, the notification is re-sent every N
# minutes (min 1) until all are CHECKED or the Riga day ends.
# NOTAM_REMINDER_INTERVAL_MIN=120
# Public base URL used for the link in that notification.
# DIGITAL_WALL_PUBLIC_URL=https://clearway.verxyl.com/digital-wall
# Local hour + timezone of the daily run (defaults: 10:00 Europe/Riga).
# NOTAM_CHECK_HOUR=10
# NOTAM_CHECK_TZ=Europe/Riga
# (Retired: ALERT_EMAIL_TO and ALERT_SCAN_INTERVAL_MS — the continuous
#  scanner and per-finding emails were replaced by the single daily run.)
