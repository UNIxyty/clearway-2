{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "types": ["chrome"],
    "baseUrl": ".",
    "paths": { "@/*": ["../*"], "~/*": ["./src/*"] }
  },
  "include": ["src", "../components/agent", "../shared"]
}
